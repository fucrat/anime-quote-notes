---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 820px;
				margin: 0 auto;
				padding: 2em 0 4em 0;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				color: rgb(var(--gray-dark));
			}
			.title-section {
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgba(var(--gray), 20%);
				text-align: center;
			}
			.title-section h1 {
				margin: 0.5rem 0;
				font-size: 2.2rem;
				line-height: 1.25;
				color: rgb(var(--black));
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.last-updated-on {
				font-style: italic;
			}

			/* --- YouTube動画埋め込みの最適化 --- */
			.prose :global(iframe) {
				width: 100%;
				aspect-ratio: 16 / 9;
				height: auto;
				border-radius: 12px;
				box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
				margin: 1.5rem 0 2rem 0;
				border: 1px solid rgba(0, 0, 0, 0.08);
			}

			/* --- アニメ名言・セリフ引用ブロックの強調 --- */
			.prose :global(blockquote) {
				border-left: 4px solid var(--accent);
				background: #f8fafc;
				padding: 1rem 1.4rem;
				margin: 1.8rem 0;
				border-radius: 0 10px 10px 0;
				color: #1e293b;
				font-size: 1.05rem;
				line-height: 1.6;
			}
			.prose :global(blockquote p) {
				margin: 0;
			}

			/* --- 見出しと解説セクションのメリハリ --- */
			.prose :global(h2) {
				font-size: 1.5rem;
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				padding-bottom: 0.4rem;
				border-bottom: 2px solid #e2e8f0;
				color: #0f172a;
			}
			.prose :global(h3) {
				font-size: 1.25rem;
				margin-top: 1.8rem;
				margin-bottom: 0.6rem;
				color: #1e293b;
			}

			/* --- 語彙・対訳リストの読みやすさ向上 --- */
			.prose :global(ul) {
				padding-left: 1.4rem;
				margin-bottom: 1.5rem;
			}
			.prose :global(li) {
				margin-bottom: 0.5rem;
				line-height: 1.6;
			}
			.prose :global(strong) {
				color: #0f172a;
			}

			/* --- ふりがな（ルビ）の調整 --- */
			.prose :global(ruby) {
				ruby-align: center;
				font-weight: 500;
			}
			.prose :global(rt) {
				font-size: 0.6em;
				color: #64748b;
				user-select: none; /* コピー時にふりがなが混ざるのを防止 */
				transform: translateY(-2px);
			}

			/* --- 品詞ラベル（バッジ）共通設定 --- */
			.prose :global(.badge) {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 700;
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				margin-left: 0.4rem;
				vertical-align: middle;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				line-height: 1.2;
			}

			/* --- 品詞ごとの色分け --- */
			.prose :global(.badge-noun) {
				color: #0369a1;
				background-color: #e0f2fe;
				border: 1px solid #bae6fd;
			}
			.prose :global(.badge-verb) {
				color: #15803d;
				background-color: #dcfce7;
				border: 1px solid #bbf7d0;
			}
			.prose :global(.badge-adj) {
				color: #b45309;
				background-color: #fef3c7;
				border: 1px solid #fde68a;
			}
			.prose :global(.badge-particle) {
				color: #6b21a8;
				background-color: #f3e8ff;
				border: 1px solid #e9d5ff;
			}
			.prose :global(.badge-lore) {
				color: #be123c;
				background-color: #ffe4e6;
				border: 1px solid #fecdd3;
			}

			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 1.5em 1em 3em 1em;
				}
				.title-section h1 {
					font-size: 1.7rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="title-section">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>